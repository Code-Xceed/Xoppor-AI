# ─────────────────────────────────────────────────────────────
# Xoppor AI environment — copy to .env and fill in what you have.
# Everything except DATABASE_URL is optional; the app degrades gracefully.
# ─────────────────────────────────────────────────────────────

# SQLite database (relative to the prisma/ folder)
DATABASE_URL="file:./dev.db"

# ── Your profile (feeds the AI scoring prompt — tune to YOUR role) ──
USER_NAME=""
USER_TITLE="Fullstack Developer & AI Engineer"
USER_BIO="specializing in fullstack web apps, SaaS MVPs, and modern software"
USER_PORTFOLIO=""

# Extra skill keywords the radar should hunt for, comma-separated
# (e.g. "figma, video editing, data analysis, rust"). Added to the built-in lens.
USER_KEYWORDS=""

# Free AI key: https://aistudio.google.com/apikey (free tier is enough)
# "gemini-flash-latest" is a rolling alias — always points to a live flash model.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Free Telegram bot: @BotFather → /newbot, then chat id from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Telegram alert threshold (0-100)
MIN_OPPORTUNITY_SCORE="70"

# Run the radar automatically while `npm start` is up
SCHEDULER_ENABLED="false"
SCOUT_INTERVAL_MINUTES="30"
DIGEST_HOUR_UTC="16"

# Free: https://www.reddit.com/prefs/apps → script app (read-only userless OAuth)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Custom User-Agent for scout requests (some sites appreciate an identifiable one)
SCOUT_USER_AGENT=""

# Optional shared secret for public deployments. When set, ALL API endpoints
# (and the dashboard) require this key — enter it once on the Settings page.
CRON_SECRET=""
